# =============================================================================
# GatoPouch — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in real values for production.
# DO NOT commit your real .env file (it's in .gitignore by default).

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Option A — SQLite (development only, NOT recommended for production)
DATABASE_URL="file:./db/custom.db"

# Option B — MySQL (production, recommended for Hostinger)
# Create a MySQL database in hPanel → Databases → MySQL
# Replace user, password, host, port (3306), and database name
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/gatopouch"

# Option C — PostgreSQL (production alternative)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gatopouch"

# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
# Public URL of your deployed site (used for SEO, OpenGraph, etc.)
NEXT_PUBLIC_SITE_URL="https://gatopouch.com"

# -----------------------------------------------------------------------------
# EMAIL SERVICE — for /api/contact and /api/newsletter
# -----------------------------------------------------------------------------
# Currently the API routes log emails to console + store in DB.
# To actually send emails, integrate a service like Resend.
#
# 1. Install: bun add resend
# 2. Sign up at https://resend.com (free 3000 emails/month)
# 3. Verify your sending domain (gatopouch.com)
# 4. Create API key and paste below
# 5. Uncomment the Resend code blocks in:
#    - src/app/api/contact/route.ts
#    - src/app/api/newsletter/route.ts
RESEND_API_KEY=""
FROM_EMAIL="no-reply@gatopouch.com"
CONTACT_EMAIL="contact@gatopouch.com"
NEWSLETTER_EMAIL="newsletter@gatopouch.com"
SUPPORT_EMAIL="support@gatopouch.com"

# -----------------------------------------------------------------------------
# SHOPIFY / CHECKOUT (optional, if you want to wire up direct Shopify API)
# -----------------------------------------------------------------------------
# Currently CTAs redirect to: https://gatopouch.com/products/sudadera-con-bolsillo-para-gato-sherpa-ultra-suave
# To integrate Shopify checkout API directly (instead of redirect):
# SHOPIFY_STORE_DOMAIN="gatopouch.myshopify.com"
# SHOPIFY_STOREFRONT_TOKEN=""
# SHOPIFY_PRODUCT_ID=""

# -----------------------------------------------------------------------------
# ANALYTICS (optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate a random 32+ char string: openssl rand -base64 32
NEXTAUTH_SECRET=""

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# - .env is gitignored and NEVER pushed to GitHub
# - .env.example is tracked and shared with the team
# - On Hostinger: create .env in your project root and fill values
# - After changing .env, restart the app (pm2 restart or systemctl restart)
# - Rotate secrets periodically (every 3-6 months)
